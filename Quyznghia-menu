local startTime = os.time()
local frameCount, lastUpdate, currentFPS = 0, os.clock(), 0

RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local now = os.clock()
    if now - lastUpdate >= 1 then
        currentFPS = math.floor(frameCount / (now - lastUpdate))
        frameCount = 0
        lastUpdate = now
    end
end)

task.spawn(function()
    while true do
        local elapsed = os.time() - startTime
        local mins, secs = math.floor(elapsed / 60), elapsed % 60
        local timeStr = string.format("%02d:%02d", mins, secs)
        infoLabel.Text = string.format(
            '<font color="rgb(255,230,0)">%d FPS</font>   <font color="rgb(255,60,60)">%s</font>   <font color="rgb(230,60,255)">%s</font>',
            currentFPS, timeStr, player.Name
        )
        task.wait(0.5)
    end
end)

createToggle("Status Banner", true, function(state)
    bannerFrame.Visible = state
end)

-- B. FE Desync Hitbox Toggle
getgenv().DesyncState = false
RunService.Heartbeat:Connect(function()
    if getgenv().DesyncState then
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            local oldCF = hrp.CFrame
            hrp.CFrame = hrp.CFrame + Vector3.new(0, 50, 0)
            RunService.RenderStepped:Wait()
            hrp.CFrame = oldCF
        end
    end
end)

createToggle("FE Desync (Anti-Hit)", false, function(state)
    getgenv().DesyncState = state
end)
