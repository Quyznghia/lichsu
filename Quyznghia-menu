local function addItem(name, callback)
    local itemRow = Instance.new("Frame", itemScroll)
    itemRow.Size = UDim2.new(1, 0, 0, 38)
    itemRow.BackgroundColor3 = Color3.fromRGB(20, 32, 50)
    local rowCorner = Instance.new("UICorner", itemRow)
    rowCorner.CornerRadius = UDim.new(0, 6)

    local nameLabel = Instance.new("TextLabel", itemRow)
    nameLabel.Size = UDim2.new(1, -90, 1, 0)
    nameLabel.Position = UDim2.new(0, 12, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = name
    nameLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
    nameLabel.TextSize = 13
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left

    -- Nút bấm màu xanh (Click) y hệt mẫu
    local btn = Instance.new("TextButton", itemRow)
    btn.Size = UDim2.new(0, 70, 0, 24)
    btn.Position = UDim2.new(1, -78, 0.5, -12)
    btn.BackgroundColor3 = Color3.fromRGB(0, 150, 255) -- Nút màu xanh dương sáng
    btn.Text = "Click"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.SourceSansBold
    
    local btnCorner = Instance.new("UICorner", btn)
    btnCorner.CornerRadius = UDim.new(0, 4)

    btn.MouseButton1Click:Connect(function()
        if callback then callback() end
    end)
end

-- Hàm tạo danh mục bên trái (Sidebar Tab)
local function addTab(tabName)
    local tabBtn = Instance.new("TextButton", sidebar)
    tabBtn.Size = UDim2.new(1, 0, 0, 30)
    tabBtn.BackgroundColor3 = Color3.fromRGB(20, 32, 50)
    tabBtn.Text = tabName
    tabBtn.TextColor3 = Color3.fromRGB(180, 200, 220)
    tabBtn.TextSize = 13
    tabBtn.Font = Enum.Font.SourceSansBold
    local tabCorner = Instance.new("UICorner", tabBtn)
    tabCorner.CornerRadius = Instance.new("UICorner", tabBtn) and UDim.new(0, 4)

    tabBtn.MouseButton1Click:Connect(function()
        contentTitle.Text = tabName
    end)
end

